### Colorful standard library: math
### Short prefix: math.sqrt(2.0), math.pow(2.0, 10.0), math.pi()
### The heavy lifting happens in the runtime (libm); the module is the typed,
### documented surface. There is no dynamic dispatch here: every call is
### statically resolved to the runtime symbol.

module math

extern def cf_math_sqrt(x: float) -> float
extern def cf_math_sin(x: float) -> float
extern def cf_math_cos(x: float) -> float
extern def cf_math_tan(x: float) -> float
extern def cf_math_log(x: float) -> float
extern def cf_math_log10(x: float) -> float
extern def cf_math_pow(x: float, y: float) -> float
extern def cf_math_ipow(x: int, y: int) -> int
extern def cf_math_floor(x: float) -> float
extern def cf_math_ceil(x: float) -> float
extern def cf_math_round(x: float) -> float
extern def cf_math_absf(x: float) -> float
extern def cf_math_absi(x: int) -> int
extern def cf_math_pi() -> float
extern def cf_math_e() -> float


def sqrt(x: float) -> float:
    return cf_math_sqrt(x)


def sin(x: float) -> float:
    return cf_math_sin(x)


def cos(x: float) -> float:
    return cf_math_cos(x)


def tan(x: float) -> float:
    return cf_math_tan(x)


def log(x: float) -> float:
    return cf_math_log(x)


def log10(x: float) -> float:
    return cf_math_log10(x)


def pow(x: float, y: float) -> float:
    return cf_math_pow(x, y)


def ipow(x: int, y: int) -> int:
    return cf_math_ipow(x, y)


def floor(x: float) -> float:
    return cf_math_floor(x)


def ceil(x: float) -> float:
    return cf_math_ceil(x)


def round(x: float) -> float:
    return cf_math_round(x)


def abs(x: float) -> float:
    return cf_math_absf(x)


def abs_int(x: int) -> int:
    return cf_math_absi(x)


def pi() -> float:
    return cf_math_pi()


def e() -> float:
    return cf_math_e()


def is_prime(n: int) -> bool:
    if n < 2:
        return False
    i = 2
    while i * i <= n:
        if n % i == 0:
            return False
        i += 1
    return True


def gcd(a: int, b: int) -> int:
    x = a
    y = b
    while y != 0:
        t = y
        y = x % y
        x = t
    return x


def factorial(n: int) -> int:
    out = 1
    i = 1
    while i <= n:
        out *= i
        i += 1
    return out
