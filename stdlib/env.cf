### Colorful standard library: env
### Short prefix: env.get("HOME"), env.require("API_KEY"), env.cwd()
###
### The process environment and working directory, so configuration can come
### from outside the program. get() never raises: an unset variable is "" and
### `env.get("PORT") or "8080"` supplies the default. require() is the strict
### variant, for values the program cannot invent.

module env

extern def cf_env_get(key: str) -> str
extern def cf_env_has(key: str) -> int
extern def cf_env_set(key: str, value: str) -> int
extern def cf_fs_cwd() -> str


### The value of an environment variable, or "" when it is not set.
def get(key: str) -> str:
    return cf_env_get(key)


### The value of an environment variable, or `fallback` when it is not set.
def get_or(key: str, fallback: str) -> str:
    if cf_env_has(key) == 1:
        return cf_env_get(key)
    return fallback


### True when the variable is set, even when its value is empty.
def has(key: str) -> bool:
    return cf_env_has(key) == 1


### The value of an environment variable; raises KeyError when it is not set.
def require(key: str) -> str:
    if cf_env_has(key) == 1:
        return cf_env_get(key)
    raise KeyError("env: '" + key + "' is not set")


### Sets a variable for this process and the programs it starts; an empty value
### removes it. Returns true when the OS accepted the change.
def set(key: str, value: str) -> bool:
    return cf_env_set(key, value) == 1


### The current working directory; "" when the OS refuses to report it.
def cwd() -> str:
    return cf_fs_cwd()
